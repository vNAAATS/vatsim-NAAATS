[Unit]
Description=vNAAATS server
After=network-online.target
Wants=network-online.target

[Service]
User=vnaaats
Group=vnaaats
WorkingDirectory=/opt/vnaaats
EnvironmentFile=/etc/vnaaats.env
ExecStart=/usr/bin/python3 /opt/vnaaats/vnaaats_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vnaaats
PrivateTmp=true

[Install]
WantedBy=multi-user.target
